# Optional gateway override. Local development uses the Vite /backend proxy by default.
VITE_API_BASE_URL=

# Match the Cashfree environment configured by the backend.
VITE_CASHFREE_MODE=sandbox

# Staging domain at /: set VITE_BASE_PATH=/ when building.
# Leave blank to keep the existing GitHub Pages build path.
VITE_BASE_PATH=
